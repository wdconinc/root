--- cmake/modules/RootMacros.cmake
+++ cmake/modules/RootMacros.cmake
@@ -1157,7 +1161,11 @@
 function(ROOT_STANDARD_LIBRARY_PACKAGE libname)
   ROOT_GET_SOURCES(lib_srcs src ${ARGN})
   if(NOT lib_srcs)
-    add_library(${libname} SHARED ${lib_srcs})
+    if(EMSCRIPTEN OR NOT BUILD_SHARED_LIBS)
+      add_library(${libname} STATIC ${lib_srcs})
+    else()
+      add_library(${libname} SHARED ${lib_srcs})
+    endif()
     return()
   endif()
   ROOT_GENERATE_DICTIONARY(G__${libname} ${libname}.h OPTIONS ${ARG_OPTIONS} DEPENDENCIES ${libname})
